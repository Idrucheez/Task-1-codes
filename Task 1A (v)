;Register Map
RCC_AHB1ENR   EQU  0x40023830    ; AHB1 peripheral clock control register
GPIOB_MODER   EQU  0x40020400    ; Port B pin direction config register
GPIOB_OTYPER  EQU  0x40020404    ; Port B output driver type register
GPIOB_OSPEEDR EQU  0x40020408    ; Port B pin speed config register
GPIOB_ODR     EQU  0x40020414    ; Port B data output register
LED_ON        EQU  0x00000001    ; PB0 driven high via bit 0 (LED on)
LED_OFF       EQU  0x00000000    ; PB0 driven low via bit 0 (LED off)
DELAY_COUNT   EQU  500000        ; Iteration count for busy-wait pause

    AREA  MYCODE, CODE, READONLY
    EXPORT __main
    ENTRY
__main
; GPIOB Initialisation
    ; Activate GPIOB clock by setting bit 1 in RCC_AHB1ENR
    LDR  R0, =RCC_AHB1ENR
    LDR  R1, =0x00000002
    STR  R1, [R0]
    ; Set PB0 to general-purpose output (MODER bits 1:0 = 01, value 0x1)
    LDR  R0, =GPIOB_MODER
    LDR  R1, =0x00000001
    STR  R1, [R0]
    ; Configure PB0 as push-pull output (OTYPER bit 0 cleared to 0)
    LDR  R0, =GPIOB_OTYPER
    LDR  R1, =0x00000000
    STR  R1, [R0]
    ; Hold PB0 at low speed setting (OSPEEDR bits 1:0 both cleared)
    LDR  R0, =GPIOB_OSPEEDR
    LDR  R1, =0x00000000
    STR  R1, [R0]
; Blink sequence
LOOP
    ; Assert PB0 high to illuminate LED (ODR bit 0 set to 1)
    LDR  R0, =GPIOB_ODR
    LDR  R1, =LED_ON
    STR  R1, [R0]
    ; First busy-wait pause
    LDR  R2, =DELAY_COUNT
DELAY1
    SUBS R2, R2, #1
    BNE  DELAY1
    ; Clear PB0 to extinguish LED (ODR bit 0 set to 0)
    LDR  R0, =GPIOB_ODR
    LDR  R1, =LED_OFF
    STR  R1, [R0]
    ; Second busy-wait pause
    LDR  R2, =DELAY_COUNT
DELAY2
    SUBS R2, R2, #1
    BNE  DELAY2
    B    LOOP          ; Jump back and run indefinitely
    
    ALIGN
    END
