
;----- RCC Registers -----
RCC_AHB1ENR     EQU     0x40023830
RCC_APB1ENR     EQU     0x40023840

;----- GPIOB Registers -----
GPIOB_MODER     EQU     0x40020400
GPIOB_OTYPER    EQU     0x40020404
GPIOB_OSPEEDR   EQU     0x40020408
GPIOB_PUPDR     EQU     0x4002040C
GPIOB_AFRH      EQU     0x40020424

;----- I2C1 Registers -----
I2C1_CR1        EQU     0x40005400
I2C1_CR2        EQU     0x40005404
I2C1_DR         EQU     0x40005410
I2C1_SR1        EQU     0x40005414
I2C1_SR2        EQU     0x40005418
I2C1_CCR        EQU     0x4000541C
I2C1_TRISE      EQU     0x40005420

;----- OLED Constants -----
OLED_ADDR_W     EQU     0x78            ; (0x3C << 1) for write


                AREA    asm_area, CODE, READONLY
                EXPORT  __main

__main
                BL      SystemClock_Config
                BL      I2C1_GPIO_Init
                BL      I2C1_Init
                
                ; Long delay to let OLED power up fully
                LDR     R0, =800000
PwrUp           SUBS    R0, R0, #1
                BNE     PwrUp
                
                BL      OLED_Init
                
                ; Short delay after init
                LDR     R0, =200000
PostInit        SUBS    R0, R0, #1
                BNE     PostInit
                
                BL      OLED_ClearScreen
                
                ; Draw Row 1: "Programming My" at page 0
                LDR     R0, =Msg_Row1
                MOV     R1, #0          ; x = 0
                MOV     R2, #0          ; page = 0 (top row)
                BL      OLED_DrawString
                
                ; Draw Row 2: "STM32F4XX Board" at page 2
                LDR     R0, =Msg_Row2
                MOV     R1, #0          ; x = 0
                MOV     R2, #2          ; page = 2 (bottom row)
                BL      OLED_DrawString
                
                ; Send buffer to OLED
                BL      OLED_UpdateDisplay

MainLoop        B       MainLoop


; SystemClock_Config: Enable clocks for GPIOB and I2C1

SystemClock_Config
                PUSH    {R0-R2, LR}
                
                ; Enable GPIOB clock (bit 1)
                LDR     R0, =RCC_AHB1ENR
                LDR     R1, [R0]
                ORR     R1, R1, #0x02
                STR     R1, [R0]
                
                ; Enable I2C1 clock (bit 21)
                LDR     R0, =RCC_APB1ENR
                LDR     R1, [R0]
                LDR     R2, =0x00200000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                ; Small delay for clocks to stabilize
                LDR     R0, =10000
ClkDly          SUBS    R0, R0, #1
                BNE     ClkDly
                
                POP     {R0-R2, PC}


; I2C1_GPIO_Init: Configure PB8 (SCL) and PB9 (SDA) for I2C1 AF4

I2C1_GPIO_Init
                PUSH    {R0-R2, LR}
                
                ; PB8, PB9 = Alternate Function mode (10)
                LDR     R0, =GPIOB_MODER
                LDR     R1, [R0]
                LDR     R2, =0x000F0000
                BIC     R1, R1, R2
                LDR     R2, =0x000A0000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                ; PB8, PB9 = Open-Drain
                LDR     R0, =GPIOB_OTYPER
                LDR     R1, [R0]
                ORR     R1, R1, #0x0300
                STR     R1, [R0]
                
                ; PB8, PB9 = High speed
                LDR     R0, =GPIOB_OSPEEDR
                LDR     R1, [R0]
                LDR     R2, =0x000F0000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                ; PB8, PB9 = Pull-up (01)
                LDR     R0, =GPIOB_PUPDR
                LDR     R1, [R0]
                LDR     R2, =0x000F0000
                BIC     R1, R1, R2
                LDR     R2, =0x00050000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                ; AF4 for PB8 (AFRH bits[3:0]) and PB9 (AFRH bits[7:4])
                LDR     R0, =GPIOB_AFRH
                LDR     R1, [R0]
                BIC     R1, R1, #0xFF
                ORR     R1, R1, #0x44
                STR     R1, [R0]
                
                POP     {R0-R2, PC}


; I2C1_Init: Standard mode 100kHz, APB1 = 16MHz (HSI default)

I2C1_Init
                PUSH    {R0-R1, LR}
                
                ; Disable I2C1
                LDR     R0, =I2C1_CR1
                MOV     R1, #0
                STR     R1, [R0]
                
                ; Software reset
                LDR     R0, =I2C1_CR1
                LDR     R1, =0x8000
                STR     R1, [R0]
                MOV     R1, #0
                STR     R1, [R0]
                
                ; FREQ = 16 MHz
                LDR     R0, =I2C1_CR2
                MOV     R1, #16
                STR     R1, [R0]
                
                ; CCR = 80 (0x50) for 100kHz
                LDR     R0, =I2C1_CCR
                MOV     R1, #0x50
                STR     R1, [R0]
                
                ; TRISE = 17
                LDR     R0, =I2C1_TRISE
                MOV     R1, #17
                STR     R1, [R0]
                
                ; Enable I2C1
                LDR     R0, =I2C1_CR1
                MOV     R1, #0x01
                STR     R1, [R0]
                
                POP     {R0-R1, PC}


; I2C_Start

I2C_Start
                PUSH    {R0-R1, LR}
                LDR     R0, =I2C1_CR1
                LDR     R1, [R0]
                ORR     R1, R1, #0x0100
                STR     R1, [R0]
WaitSB
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x01
                BEQ     WaitSB
                POP     {R0-R1, PC}


; I2C_SendAddr: R0 = address byte (already shifted with R/W bit)

I2C_SendAddr
                PUSH    {R0-R2, LR}
                MOV     R2, R0
                LDR     R0, =I2C1_DR
                STR     R2, [R0]
WaitADDR
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x02
                BEQ     WaitADDR
                ; Clear ADDR by reading SR1 then SR2
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                LDR     R0, =I2C1_SR2
                LDR     R1, [R0]
                POP     {R0-R2, PC}


; I2C_SendByte: R0 = data byte

I2C_SendByte
                PUSH    {R0-R2, LR}
                MOV     R2, R0
WaitTXE
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x80
                BEQ     WaitTXE
                LDR     R0, =I2C1_DR
                STR     R2, [R0]
WaitBTF
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x04
                BEQ     WaitBTF
                POP     {R0-R2, PC}


; I2C_Stop

I2C_Stop
                PUSH    {R0-R1, LR}
                LDR     R0, =I2C1_CR1
                LDR     R1, [R0]
                ORR     R1, R1, #0x0200
                STR     R1, [R0]
                ; Small delay after stop
                MOV     R0, #100
StopDly         SUBS    R0, R0, #1
                BNE     StopDly
                POP     {R0-R1, PC}


; OLED_SendCommand: Send one command byte to SSD1306
; Input: R0 = command byte

OLED_SendCommand
                PUSH    {R4, LR}
                MOV     R4, R0          ; Save command in R4
                
                BL      I2C_Start
                MOV     R0, #OLED_ADDR_W
                BL      I2C_SendAddr
                MOV     R0, #0x00       ; Control byte: command mode
                BL      I2C_SendByte
                MOV     R0, R4          ; Restore command
                BL      I2C_SendByte
                BL      I2C_Stop
                
                POP     {R4, PC}


; OLED_Init: Full SSD1306 initialization for 128x32

OLED_Init
                PUSH    {R4, LR}
                
                MOV     R0, #0xAE       ; Display OFF
                BL      OLED_SendCommand
                
                MOV     R0, #0xD5       ; Set display clock
                BL      OLED_SendCommand
                MOV     R0, #0x80
                BL      OLED_SendCommand
                
                MOV     R0, #0xA8       ; Set multiplex ratio
                BL      OLED_SendCommand
                MOV     R0, #0x1F       ; 31 for 32 rows
                BL      OLED_SendCommand
                
                MOV     R0, #0xD3       ; Set display offset
                BL      OLED_SendCommand
                MOV     R0, #0x00
                BL      OLED_SendCommand
                
                MOV     R0, #0x40       ; Set start line 0
                BL      OLED_SendCommand
                
                MOV     R0, #0x8D       ; Charge pump
                BL      OLED_SendCommand
                MOV     R0, #0x14       ; Enable
                BL      OLED_SendCommand
                
                MOV     R0, #0x20       ; Memory addressing mode
                BL      OLED_SendCommand
                MOV     R0, #0x00       ; Horizontal
                BL      OLED_SendCommand
                
                MOV     R0, #0xA1       ; Segment remap
                BL      OLED_SendCommand
                
                MOV     R0, #0xC8       ; COM scan direction
                BL      OLED_SendCommand
                
                MOV     R0, #0xDA       ; COM pins config
                BL      OLED_SendCommand
                MOV     R0, #0x02
                BL      OLED_SendCommand
                
                MOV     R0, #0x81       ; Set contrast
                BL      OLED_SendCommand
                MOV     R0, #0x8F
                BL      OLED_SendCommand
                
                MOV     R0, #0xD9       ; Pre-charge period
                BL      OLED_SendCommand
                MOV     R0, #0xF1
                BL      OLED_SendCommand
                
                MOV     R0, #0xDB       ; VCOMH deselect
                BL      OLED_SendCommand
                MOV     R0, #0x40
                BL      OLED_SendCommand
                
                MOV     R0, #0xA4       ; Display from RAM
                BL      OLED_SendCommand
                
                MOV     R0, #0xA6       ; Normal display
                BL      OLED_SendCommand
                
                MOV     R0, #0xAF       ; Display ON
                BL      OLED_SendCommand
                
                POP     {R4, PC}


; OLED_ClearScreen: Send all zeros directly to OLED (512 bytes)
; This clears both the buffer in RAM and the screen

OLED_ClearScreen
                PUSH    {R4-R6, LR}
                
                ; First clear the RAM buffer
                LDR     R4, =DisplayBuffer
                MOV     R5, #0
                LDR     R6, =512
ClrBuf
                STRB    R5, [R4], #1
                SUBS    R6, R6, #1
                BNE     ClrBuf
                
                ; Now send cleared buffer to each page
                MOV     R4, #0          ; page counter
ClrPageLoop
                CMP     R4, #4
                BEQ     ClrDone
                
                ; Set page address
                MOV     R0, R4
                ADD     R0, R0, #0xB0
                BL      OLED_SendCommand
                MOV     R0, #0x00
                BL      OLED_SendCommand
                MOV     R0, #0x10
                BL      OLED_SendCommand
                
                ; Send 128 zero bytes
                BL      I2C_Start
                MOV     R0, #OLED_ADDR_W
                BL      I2C_SendAddr
                MOV     R0, #0x40       ; Data mode
                BL      I2C_SendByte
                
                MOV     R5, #128
ClrColLoop
                MOV     R0, #0x00
                BL      I2C_SendByte
                SUBS    R5, R5, #1
                BNE     ClrColLoop
                
                BL      I2C_Stop
                
                ADD     R4, R4, #1
                B       ClrPageLoop
ClrDone
                POP     {R4-R6, PC}


; OLED_UpdateDisplay: Send RAM buffer to OLED, page by page

OLED_UpdateDisplay
                PUSH    {R4-R6, LR}
                
                MOV     R4, #0          ; page counter
                LDR     R5, =DisplayBuffer

UpdPageLoop
                CMP     R4, #4
                BEQ     UpdDone
                
                ; Set page address
                MOV     R0, R4
                ADD     R0, R0, #0xB0
                BL      OLED_SendCommand
                MOV     R0, #0x00       ; Lower column = 0
                BL      OLED_SendCommand
                MOV     R0, #0x10       ; Upper column = 0
                BL      OLED_SendCommand
                
                ; Start I2C data transfer
                BL      I2C_Start
                MOV     R0, #OLED_ADDR_W
                BL      I2C_SendAddr
                MOV     R0, #0x40       ; Data mode
                BL      I2C_SendByte
                
                MOV     R6, #128
UpdColLoop
                LDRB    R0, [R5], #1
                BL      I2C_SendByte
                SUBS    R6, R6, #1
                BNE     UpdColLoop
                
                BL      I2C_Stop
                
                ADD     R4, R4, #1
                B       UpdPageLoop
UpdDone
                POP     {R4-R6, PC}


; OLED_DrawString: Write string into RAM buffer
; R0 = pointer to null-terminated string
; R1 = x starting pixel (0-127)
; R2 = page number (0, 1, 2, or 3)

OLED_DrawString
                PUSH    {R4-R8, LR}
                MOV     R4, R0          ; string pointer
                MOV     R5, R1          ; x position
                MOV     R6, R2          ; page number

DStrLoop
                LDRB    R7, [R4], #1    ; Load char
                CMP     R7, #0          ; Null?
                BEQ     DStrDone
                CMP     R7, #32         ; Below space?
                BLT     DStrDone
                CMP     R7, #127        ; Above tilde?
                BGT     DStrDone
                
                ; Font offset = (char - 32) * 5
                SUB     R0, R7, #32
                MOV     R1, #5
                MUL     R0, R0, R1
                LDR     R1, =Font5x7
                ADD     R8, R1, R0      ; R8 = font data pointer
                
                ; Buffer offset = (page * 128) + x
                MOV     R0, R6
                LSL     R0, R0, #7      ; page * 128
                ADD     R0, R0, R5      ; + x
                LDR     R1, =DisplayBuffer
                ADD     R1, R1, R0      ; R1 = destination in buffer
                
                ; Copy 5 font bytes
                LDRB    R0, [R8, #0]
                STRB    R0, [R1, #0]
                LDRB    R0, [R8, #1]
                STRB    R0, [R1, #1]
                LDRB    R0, [R8, #2]
                STRB    R0, [R1, #2]
                LDRB    R0, [R8, #3]
                STRB    R0, [R1, #3]
                LDRB    R0, [R8, #4]
                STRB    R0, [R1, #4]
                
                ADD     R5, R5, #6      ; Next char position
                B       DStrLoop
DStrDone
                POP     {R4-R8, PC}


; DATA SECTION (in RAM)

                AREA    mydata, DATA, READWRITE
                ALIGN

DisplayBuffer   SPACE   512


; READ-ONLY DATA SECTION

                AREA    constdata, DATA, READONLY
                ALIGN

Msg_Row1        DCB     "Programming My", 0
                ALIGN
Msg_Row2        DCB     "STM32F4XX Board", 0
                ALIGN


