
;----- RCC Registers -----
RCC_AHB1ENR     EQU     0x40023830
RCC_APB1ENR     EQU     0x40023840

;----- GPIOA Registers -----
GPIOA_MODER     EQU     0x40020000
GPIOA_PUPDR     EQU     0x4002000C
GPIOA_IDR       EQU     0x40020010

;----- GPIOB Registers -----
GPIOB_MODER     EQU     0x40020400
GPIOB_OTYPER    EQU     0x40020404
GPIOB_OSPEEDR   EQU     0x40020408
GPIOB_PUPDR     EQU     0x4002040C
GPIOB_AFRH      EQU     0x40020424

;----- I2C1 Registers -----
I2C1_CR1        EQU     0x40005400
I2C1_CR2        EQU     0x40005404
I2C1_DR         EQU     0x40005410
I2C1_SR1        EQU     0x40005414
I2C1_SR2        EQU     0x40005418
I2C1_CCR        EQU     0x4000541C
I2C1_TRISE      EQU     0x40005420

;----- OLED Constants -----
OLED_ADDR_W     EQU     0x78            ; (0x3C << 1) for write


                AREA    asm_area, CODE, READONLY
                EXPORT  __main

__main
                BL      SystemClock_Config
                BL      GPIO_PA0_Init
                BL      I2C1_GPIO_Init
                BL      I2C1_Init
                
                ; Power-up delay for OLED
                LDR     R0, =800000
PwrUp           SUBS    R0, R0, #1
                BNE     PwrUp
                
                BL      OLED_Init
                
                LDR     R0, =200000
PostInit        SUBS    R0, R0, #1
                BNE     PostInit
                
                BL      OLED_ClearScreen
                
                ; Store last known state so we only update on change
                ; R9 = previous state (0xFF = uninitialized)
                MOV     R9, #0xFF


; Main Loop: Continuously read PA0 and update OLED if state changed

MainLoop
                ; Read PA0 from GPIOA_IDR
                LDR     R0, =GPIOA_IDR
                LDR     R1, [R0]
                AND     R1, R1, #0x01   ; Isolate bit 0 (PA0)
                
                ; Compare with previous state
                CMP     R1, R9
                BEQ     MainLoop        ; No change, keep polling
                
                ; State changed - update R9 and refresh display
                MOV     R9, R1
                
                ; Clear buffer
                BL      OLED_ClearBuffer
                
                ; Check if Logic 0 or Logic 1
                CMP     R9, #0
                BEQ     ShowLogic0
                

ShowLogic1
                LDR     R0, =Msg_Logic1
                MOV     R1, #0
                MOV     R2, #0          ; Page 0 (Row 1)
                BL      OLED_DrawString
                
                LDR     R0, =Msg_Pressed
                MOV     R1, #0
                MOV     R2, #2          ; Page 2 (Row 2)
                BL      OLED_DrawString
                
                B       RefreshOLED


ShowLogic0
                LDR     R0, =Msg_Logic0
                MOV     R1, #0
                MOV     R2, #0          ; Page 0 (Row 1)
                BL      OLED_DrawString
                
                LDR     R0, =Msg_Unpressed
                MOV     R1, #0
                MOV     R2, #2          ; Page 2 (Row 2)
                BL      OLED_DrawString

RefreshOLED
                BL      OLED_UpdateDisplay
                
                ; Small debounce delay
                LDR     R0, =200000
Debounce        SUBS    R0, R0, #1
                BNE     Debounce
                
                B       MainLoop


; SystemClock_Config: Enable clocks for GPIOA, GPIOB, and I2C1

SystemClock_Config
                PUSH    {R0-R2, LR}
                
                ; Enable GPIOA clock (bit 0) and GPIOB clock (bit 1)
                LDR     R0, =RCC_AHB1ENR
                LDR     R1, [R0]
                ORR     R1, R1, #0x03   ; Bits 0 and 1
                STR     R1, [R0]
                
                ; Enable I2C1 clock (bit 21)
                LDR     R0, =RCC_APB1ENR
                LDR     R1, [R0]
                LDR     R2, =0x00200000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                ; Clock stabilization delay
                LDR     R0, =10000
ClkDly          SUBS    R0, R0, #1
                BNE     ClkDly
                
                POP     {R0-R2, PC}


; GPIO_PA0_Init: Configure PA0 as digital input with no pull
; (external 10k pull-down resistor is used on the breadboard)

GPIO_PA0_Init
                PUSH    {R0-R2, LR}
                
                ; PA0 = Input mode (00) - bits [1:0] of MODER
                ; Default after reset is already input (00), but clear to be safe
                LDR     R0, =GPIOA_MODER
                LDR     R1, [R0]
                BIC     R1, R1, #0x03   ; Clear bits 1:0 for PA0
                STR     R1, [R0]
                
                ; PA0 = No pull-up/pull-down (00) - using external pull-down
                LDR     R0, =GPIOA_PUPDR
                LDR     R1, [R0]
                BIC     R1, R1, #0x03   ; Clear bits 1:0 for PA0
                STR     R1, [R0]
                
                POP     {R0-R2, PC}


; I2C1_GPIO_Init: Configure PB8 (SCL) and PB9 (SDA) for I2C1 AF4

I2C1_GPIO_Init
                PUSH    {R0-R2, LR}
                
                LDR     R0, =GPIOB_MODER
                LDR     R1, [R0]
                LDR     R2, =0x000F0000
                BIC     R1, R1, R2
                LDR     R2, =0x000A0000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                LDR     R0, =GPIOB_OTYPER
                LDR     R1, [R0]
                ORR     R1, R1, #0x0300
                STR     R1, [R0]
                
                LDR     R0, =GPIOB_OSPEEDR
                LDR     R1, [R0]
                LDR     R2, =0x000F0000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                LDR     R0, =GPIOB_PUPDR
                LDR     R1, [R0]
                LDR     R2, =0x000F0000
                BIC     R1, R1, R2
                LDR     R2, =0x00050000
                ORR     R1, R1, R2
                STR     R1, [R0]
                
                LDR     R0, =GPIOB_AFRH
                LDR     R1, [R0]
                BIC     R1, R1, #0xFF
                ORR     R1, R1, #0x44
                STR     R1, [R0]
                
                POP     {R0-R2, PC}


; I2C1_Init: Standard mode 100kHz, APB1 = 16MHz

I2C1_Init
                PUSH    {R0-R1, LR}
                
                LDR     R0, =I2C1_CR1
                MOV     R1, #0
                STR     R1, [R0]
                
                LDR     R0, =I2C1_CR1
                LDR     R1, =0x8000
                STR     R1, [R0]
                MOV     R1, #0
                STR     R1, [R0]
                
                LDR     R0, =I2C1_CR2
                MOV     R1, #16
                STR     R1, [R0]
                
                LDR     R0, =I2C1_CCR
                MOV     R1, #0x50
                STR     R1, [R0]
                
                LDR     R0, =I2C1_TRISE
                MOV     R1, #17
                STR     R1, [R0]
                
                LDR     R0, =I2C1_CR1
                MOV     R1, #0x01
                STR     R1, [R0]
                
                POP     {R0-R1, PC}


; I2C Low-Level Routines

I2C_Start
                PUSH    {R0-R1, LR}
                LDR     R0, =I2C1_CR1
                LDR     R1, [R0]
                ORR     R1, R1, #0x0100
                STR     R1, [R0]
WaitSB
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x01
                BEQ     WaitSB
                POP     {R0-R1, PC}

I2C_SendAddr
                PUSH    {R0-R2, LR}
                MOV     R2, R0
                LDR     R0, =I2C1_DR
                STR     R2, [R0]
WaitADDR
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x02
                BEQ     WaitADDR
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                LDR     R0, =I2C1_SR2
                LDR     R1, [R0]
                POP     {R0-R2, PC}

I2C_SendByte
                PUSH    {R0-R2, LR}
                MOV     R2, R0
WaitTXE
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x80
                BEQ     WaitTXE
                LDR     R0, =I2C1_DR
                STR     R2, [R0]
WaitBTF
                LDR     R0, =I2C1_SR1
                LDR     R1, [R0]
                TST     R1, #0x04
                BEQ     WaitBTF
                POP     {R0-R2, PC}

I2C_Stop
                PUSH    {R0-R1, LR}
                LDR     R0, =I2C1_CR1
                LDR     R1, [R0]
                ORR     R1, R1, #0x0200
                STR     R1, [R0]
                MOV     R0, #100
StopDly         SUBS    R0, R0, #1
                BNE     StopDly
                POP     {R0-R1, PC}


; OLED_SendCommand: R0 = command byte

OLED_SendCommand
                PUSH    {R4, LR}
                MOV     R4, R0
                BL      I2C_Start
                MOV     R0, #OLED_ADDR_W
                BL      I2C_SendAddr
                MOV     R0, #0x00
                BL      I2C_SendByte
                MOV     R0, R4
                BL      I2C_SendByte
                BL      I2C_Stop
                POP     {R4, PC}


; OLED_Init: SSD1306 128x32

OLED_Init
                PUSH    {R4, LR}
                
                MOV     R0, #0xAE
                BL      OLED_SendCommand
                MOV     R0, #0xD5
                BL      OLED_SendCommand
                MOV     R0, #0x80
                BL      OLED_SendCommand
                MOV     R0, #0xA8
                BL      OLED_SendCommand
                MOV     R0, #0x1F
                BL      OLED_SendCommand
                MOV     R0, #0xD3
                BL      OLED_SendCommand
                MOV     R0, #0x00
                BL      OLED_SendCommand
                MOV     R0, #0x40
                BL      OLED_SendCommand
                MOV     R0, #0x8D
                BL      OLED_SendCommand
                MOV     R0, #0x14
                BL      OLED_SendCommand
                MOV     R0, #0x20
                BL      OLED_SendCommand
                MOV     R0, #0x00
                BL      OLED_SendCommand
                MOV     R0, #0xA1
                BL      OLED_SendCommand
                MOV     R0, #0xC8
                BL      OLED_SendCommand
                MOV     R0, #0xDA
                BL      OLED_SendCommand
                MOV     R0, #0x02
                BL      OLED_SendCommand
                MOV     R0, #0x81
                BL      OLED_SendCommand
                MOV     R0, #0x8F
                BL      OLED_SendCommand
                MOV     R0, #0xD9
                BL      OLED_SendCommand
                MOV     R0, #0xF1
                BL      OLED_SendCommand
                MOV     R0, #0xDB
                BL      OLED_SendCommand
                MOV     R0, #0x40
                BL      OLED_SendCommand
                MOV     R0, #0xA4
                BL      OLED_SendCommand
                MOV     R0, #0xA6
                BL      OLED_SendCommand
                MOV     R0, #0xAF
                BL      OLED_SendCommand
                
                POP     {R4, PC}


; OLED_ClearScreen: Clear OLED hardware and RAM buffer

OLED_ClearScreen
                PUSH    {R4-R6, LR}
                
                LDR     R4, =DisplayBuffer
                MOV     R5, #0
                LDR     R6, =512
ClrBuf
                STRB    R5, [R4], #1
                SUBS    R6, R6, #1
                BNE     ClrBuf
                
                MOV     R4, #0
ClrPageLoop
                CMP     R4, #4
                BEQ     ClrDone
                MOV     R0, R4
                ADD     R0, R0, #0xB0
                BL      OLED_SendCommand
                MOV     R0, #0x00
                BL      OLED_SendCommand
                MOV     R0, #0x10
                BL      OLED_SendCommand
                BL      I2C_Start
                MOV     R0, #OLED_ADDR_W
                BL      I2C_SendAddr
                MOV     R0, #0x40
                BL      I2C_SendByte
                MOV     R5, #128
ClrColLoop
                MOV     R0, #0x00
                BL      I2C_SendByte
                SUBS    R5, R5, #1
                BNE     ClrColLoop
                BL      I2C_Stop
                ADD     R4, R4, #1
                B       ClrPageLoop
ClrDone
                POP     {R4-R6, PC}


; OLED_ClearBuffer: Clear only the RAM buffer (not the screen)

OLED_ClearBuffer
                PUSH    {R0-R2, LR}
                LDR     R0, =DisplayBuffer
                MOV     R1, #0
                LDR     R2, =512
ClrBuf2
                STRB    R1, [R0], #1
                SUBS    R2, R2, #1
                BNE     ClrBuf2
                POP     {R0-R2, PC}


; OLED_UpdateDisplay: Send RAM buffer to OLED page by page

OLED_UpdateDisplay
                PUSH    {R4-R6, LR}
                MOV     R4, #0
                LDR     R5, =DisplayBuffer
UpdPageLoop
                CMP     R4, #4
                BEQ     UpdDone
                MOV     R0, R4
                ADD     R0, R0, #0xB0
                BL      OLED_SendCommand
                MOV     R0, #0x00
                BL      OLED_SendCommand
                MOV     R0, #0x10
                BL      OLED_SendCommand
                BL      I2C_Start
                MOV     R0, #OLED_ADDR_W
                BL      I2C_SendAddr
                MOV     R0, #0x40
                BL      I2C_SendByte
                MOV     R6, #128
UpdColLoop
                LDRB    R0, [R5], #1
                BL      I2C_SendByte
                SUBS    R6, R6, #1
                BNE     UpdColLoop
                BL      I2C_Stop
                ADD     R4, R4, #1
                B       UpdPageLoop
UpdDone
                POP     {R4-R6, PC}


; OLED_DrawString: Write string into RAM buffer
; R0 = pointer to null-terminated string
; R1 = x starting pixel (0-127)
; R2 = page number (0, 1, 2, or 3)

OLED_DrawString
                PUSH    {R4-R8, LR}
                MOV     R4, R0
                MOV     R5, R1
                MOV     R6, R2
DStrLoop
                LDRB    R7, [R4], #1
                CMP     R7, #0
                BEQ     DStrDone
                CMP     R7, #32
                BLT     DStrDone
                CMP     R7, #127
                BGT     DStrDone
                SUB     R0, R7, #32
                MOV     R1, #5
                MUL     R0, R0, R1
                LDR     R1, =Font5x7
                ADD     R8, R1, R0
                MOV     R0, R6
                LSL     R0, R0, #7
                ADD     R0, R0, R5
                LDR     R1, =DisplayBuffer
                ADD     R1, R1, R0
                LDRB    R0, [R8, #0]
                STRB    R0, [R1, #0]
                LDRB    R0, [R8, #1]
                STRB    R0, [R1, #1]
                LDRB    R0, [R8, #2]
                STRB    R0, [R1, #2]
                LDRB    R0, [R8, #3]
                STRB    R0, [R1, #3]
                LDRB    R0, [R8, #4]
                STRB    R0, [R1, #4]
                ADD     R5, R5, #6
                B       DStrLoop
DStrDone
                POP     {R4-R8, PC}


; DATA SECTION (in RAM)

                AREA    mydata, DATA, READWRITE
                ALIGN

DisplayBuffer   SPACE   512


; READ-ONLY DATA SECTION

                AREA    constdata, DATA, READONLY
                ALIGN

Msg_Logic0      DCB     "Logic 0: 0 V", 0
                ALIGN
Msg_Logic1      DCB     "Logic 1: 3.3 V", 0
                ALIGN
Msg_Unpressed   DCB     "SW1 Unpressed", 0
                ALIGN
Msg_Pressed     DCB     "SW1 Pressed", 0
                ALIGN


