; Register Map
RCC_AHB1ENR   EQU  0x40023830    ; AHB1 clock control register
GPIOA_MODER   EQU  0x40020000    ; Port A pin direction register
GPIOA_OTYPER  EQU  0x40020004    ; Port A output driver register
GPIOA_OSPEEDR EQU  0x40020008    ; Port A pin speed register
GPIOA_BSRR    EQU  0x40020018    ; Port A atomic set/reset register <--- NEW!
LED_ON        EQU  0x00000020    ; Set PA5 high via BSRR bit 5 (LED on)
LED_OFF       EQU  0x00200000    ; Clear PA5 via BSRR bit 21 (LED off)  <--- NEW!
DELAY_COUNT   EQU  500000        ; Busy-wait loop iteration count (~0.5 s)

    AREA  MYCODE, CODE, READONLY
    EXPORT __main
	ENTRY
__main
; Setup GPIOA
    ; Power up GPIOA by setting bit 0 in RCC_AHB1ENR
    LDR  R0, =RCC_AHB1ENR
    LDR  R1, =0x00000001
    STR  R1, [R0]
    ; Configure PA5 as output pin (MODER bits 11:10 = 01, value 0x400)
    LDR  R0, =GPIOA_MODER
    LDR  R1, =0x00000400
    STR  R1, [R0]
    ; Set PA5 driver to push-pull mode (OTYPER bit 5 cleared to 0)
    LDR  R0, =GPIOA_OTYPER
    LDR  R1, =0x00000000
    STR  R1, [R0]
    ; Assign low speed to PA5 (OSPEEDR bits 11:10 both cleared)
    LDR  R0, =GPIOA_OSPEEDR
    LDR  R1, =0x00000000
    STR  R1, [R0]
; LED blink sequence
LOOP
    ; Assert PA5 high through BSRR bit 5 to turn LED on
    LDR  R0, =GPIOA_BSRR
    LDR  R1, =LED_ON
    STR  R1, [R0]
    ; Busy-wait pause
    LDR  R2, =DELAY_COUNT
DELAY1
    SUBS R2, R2, #1
    BNE  DELAY1
    ; Deassert PA5 through BSRR bit 21 to turn LED off
    LDR  R0, =GPIOA_BSRR
    LDR  R1, =LED_OFF
    STR  R1, [R0]
    ; Busy-wait pause
    LDR  R2, =DELAY_COUNT
DELAY2
    SUBS R2, R2, #1
    BNE  DELAY2
    B    LOOP          ; Loop back indefinitely

    ALIGN
    END
