; Register Map
RCC_AHB1ENR   EQU  0x40023830    ; AHB1 peripheral clock control register
GPIOB_MODER   EQU  0x40020400    ; Port B pin direction register
GPIOB_OTYPER  EQU  0x40020404    ; Port B output driver type register
GPIOB_OSPEEDR EQU  0x40020408    ; Port B pin speed register
GPIOB_ODR     EQU  0x40020414    ; Port B data output register <--- NEW!
LED_ON        EQU  0x00000001    ; PB0 high via bit 0 (LED illuminated)

    AREA  MYCODE, CODE, READONLY
    EXPORT __main
    ENTRY
__main
; GPIOB Startup Configuration
    ; Power up GPIOB by setting bit 1 in RCC_AHB1ENR
    LDR  R0, =RCC_AHB1ENR
    LDR  R1, =0x00000002
    STR  R1, [R0]
    ; Configure PB0 as output pin (MODER bits 1:0 = 01, value 0x1)
    LDR  R0, =GPIOB_MODER
    LDR  R1, =0x00000001
    STR  R1, [R0]
    ; Assign push-pull mode to PB0 output (OTYPER bit 0 = 0)
    LDR  R0, =GPIOB_OTYPER
    LDR  R1, =0x00000000
    STR  R1, [R0]
    ; Set PB0 to low speed operation (OSPEEDR bits 1:0 both = 0)
    LDR  R0, =GPIOB_OSPEEDR
    LDR  R1, =0x00000000
    STR  R1, [R0]
; Switch LED on and hold steady
    ; Drive PB0 high by writing 1 to ODR bit 0
    LDR  R0, =GPIOB_ODR
    LDR  R1, =LED_ON
    STR  R1, [R0]
; Hold here forever
LOOP
    ; Processor stays locked in this loop with LED remaining on.
    B    LOOP          
    
    ALIGN
    END
